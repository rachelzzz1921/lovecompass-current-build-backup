# LoveCompass 后端环境变量模板
# 说明：后端变量不应暴露给浏览器；DATABASE_URL、SUPABASE_SERVICE_ROLE_KEY、sb_secret_*、ZHIPU_API_KEY 都应只配置在服务端环境。
# 本文件只保留占位符，不写入真实密钥。真实值放入本地 .env 或 Vercel Environment Variables。

# PostgreSQL / Supabase Database
# Runtime API: Supabase pooler port 6543 with ?pgbouncer=true (Project Settings > Database > Connection pooling).
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations / DDL: direct connection (not transaction pooler).
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Supabase 项目配置
SUPABASE_URL="https://wjfpglsygkbpubanylug.supabase.co"
SUPABASE_PROJECT_ID="wjfpglsygkbpubanylug"

# 公开级别 key。可与前端 NEXT_PUBLIC_SUPABASE_ANON_KEY 使用同一个 publishable/anon key。
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx_or_anon_jwt"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxx_or_anon_jwt"

# 服务端专用 key。严禁放入前端、Lovable 浏览器代码、public repo 或 client component。
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxx_or_service_role_key"

# JWT 校验（Project Settings > API > JWT Secret）。FastAPI 用于解析 Authorization Bearer。
SUPABASE_JWT_SECRET="YOUR_SUPABASE_JWT_SECRET"

# 仅本地调试：无 Bearer 时回退到 LOVECOMPASS_DEMO_USER_ID。生产环境务必设为 false 或删除。
# 生产 Vercel 设为 false；本地调试可 true
LOVECOMPASS_ALLOW_DEMO_USER_FALLBACK="true"

# CORS：本地开发和 Vercel 临时链接均需加入
CORS_ORIGINS="http://localhost:5173,http://localhost:4173,https://YOUR_VERCEL_PREVIEW.vercel.app"

# AI Adapter
AI_PROVIDER="zhipu"
ZHIPU_API_KEY="YOUR_ZHIPU_API_KEY"
ZHIPU_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
ZHIPU_MODEL="glm-4-flash"

# 开发占位用户。生产环境应由 Supabase Auth token 解析 user_id，不应依赖固定用户。
LOVECOMPASS_DEMO_USER_ID="00000000-0000-0000-0000-000000000001"
