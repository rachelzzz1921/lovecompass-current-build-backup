  "attention_rules": [
    {
      "id": "female_response_need",
      "condition": "female.emotional_density_score > 65",
      "icon": "warn",
      "title": "她对回应节奏有一定需求",
      "desc": "在关系里需要一定频率的确认，长时间没有反馈容易不安。不是问题，但两人早点对齐节奏期待会省很多摩擦。",
      "source": "FS2"
    },
    {
      "id": "male_housing_huji",
      "condition": "male.housing_status == 'no_own' AND male.huji == 'nonlocal'",
      "icon": "warn",
      "title": "他的住房与户籍需要提前规划",
      "desc": "目前名下无独立房产，户籍在外地。如有子女就学等长期规划，建议提前讨论时间表和各自的预期。",
      "source": "MS1_A + PR1-03"
    },
    {
      "id": "edu_gap_female_higher",
      "condition": "female.education_level > male.education_level",
      "icon": "warn",
      "title": "她的学历高于他，部分家庭会在意",
      "desc": "学历差距本身不是问题，但在某些家庭场景下可能带来额外的外部压力。两人提前知道对方家里的态度，比被动面对要好。",
      "source": "PR1-02"
    },
    {
      "id": "low_family_interference",
      "condition": "male.family_interference_score < 40 AND female.family_interference_score < 40",
      "icon": "ok",
      "title": "双方家庭干预风险都低",
      "desc": "父母对感情生活的参与度都在合理范围内，不太会成为关系的外部压力来源。",
      "source": "MS5_C + FS5_C"
    },
    {
      "id": "children_timing_gap",
      "condition": "children_timing_badge in ('warn', 'alert')",
      "icon": "warn",
      "title": "婚育时间表需要对齐",
      "desc": "双方对要孩子的时间预期不完全一致，这不是谁对谁错，但越早谈越轻松。",
      "source": "PR2-02"
    },
    {
      "id": "financial_gap",
      "condition": "financial_model_badge == 'warn'",
      "icon": "warn",
      "title": "婚后财务模式需要提前聊",
      "desc": "两人对钱怎么管的想法不完全一样，提前摆上桌比婚后被动磨合更省力。",
      "source": "PR3-01"
    }
  ],
  "score_scope": {
