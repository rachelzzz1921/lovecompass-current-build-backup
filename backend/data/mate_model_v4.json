{
    "model_name": "套三（MATE）择偶坐标模型",
    "basic_positioning": {
        "core_attribute": "红娘辅助工具",
        "core_principle": "照镜子，不贴标签",
        "exclude_attribute": "非心理测试"
    },
    "core_definition": {
        "core_question": "在现实择偶市场里，别人会如何评估你？",
        "evaluation_dimensions": [
            "第一眼别人怎么看你",
            "深入接触后别人怎么感受你",
            "长期关系里别人是否愿意留下",
            "你的期待与现实是否匹配"
        ],
        "essential_purpose": "帮一个人看清自己的市场位置、匹配区间和关系上限"
    },
    "overall_structure": {
        "framework": "五模块 × 双性别独立模型 × 四象限定位",
        "gender_feature": "男女结构相似，评估逻辑、权重、题目内容不同",
        "design_reason": "现实里的筛选机制并不完全对称，模型采用「现实仿真」而非「理论平均」"
    },
    "gender_core_logic": {
        "male": {
            "core_formula": "资源 × 稳定性 × 情感供给能力",
            "screening_order": [
                "能不能托底",
                "靠不靠得住",
                "相处舒不舒服",
                "有没有风险"
            ],
            "focus_points": [
                "现实基础",
                "稳定感",
                "上升空间",
                "情感能力"
            ]
        },
        "female": {
            "core_formula": "吸引力 × 情感价值 × 现实自主性",
            "screening_order": [
                "第一感觉",
                "相处体验",
                "现实负担",
                "长期风险"
            ],
            "focus_points": [
                "吸引力持续性",
                "情绪价值",
                "独立程度",
                "关系成熟度"
            ]
        }
    },
    "five_modules": [
        {
