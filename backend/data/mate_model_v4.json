            "horizontal_axis": {
                "name": "吸引显示度",
                "meaning": "别人会不会被吸引",
                "formula": "吸引力 ×55% + 情感价值 ×45%"
            },
            "vertical_axis": {
                "name": "长期稳定度",
                "meaning": "别人会不会想长期发展",
                "formula": "现实自主 ×60% + (100−风险) ×40%"
            }
        }
