# LoveCompass 前端环境变量模板
# 说明：浏览器端只能放 Supabase URL 与 anon/publishable key。
# 严禁在本文件或任何前端代码中放入 SUPABASE_SERVICE_ROLE_KEY、sb_secret_*、DATABASE_URL 或 AI Key。

# Supabase 公开配置。当前项目已在 vite.config.ts 中允许 NEXT_PUBLIC_ 前缀被前端读取。
NEXT_PUBLIC_SUPABASE_URL="https://wjfpglsygkbpubanylug.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="从 Supabase Dashboard → API 复制 anon 或 publishable key"

# 可选：兼容 Lovable/Vite 原始命名。若已配置 NEXT_PUBLIC_*，通常不必重复配置。
VITE_SUPABASE_URL="https://wjfpglsygkbpubanylug.supabase.co"
VITE_SUPABASE_PROJECT_ID="wjfpglsygkbpubanylug"
VITE_SUPABASE_ANON_KEY="sb_publishable_xxx_or_anon_jwt"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx_or_anon_jwt"

# 独立后端 API。开发时通常为 http://localhost:8000；Vercel 生产填后端部署地址。
# 本地开发 http://localhost:8000；Vercel 生产（已部署）：
VITE_LOVECOMPASS_API_BASE_URL="https://lovecompass-api-backend.vercel.app"

# 本地 dev 且已配置远程 API 时，默认不会探测 localhost:8000。
# 若希望同时回退本机 uvicorn，设为 true：
# VITE_LOVECOMPASS_API_USE_LOCAL="true"

# 可选：国内镜像 API（香港/新加坡反代，见 docs/CHINA_MIRROR.md）
# 内地开发/访问若 vercel.app 不可达，必须配置镜像 URL，勿依赖内置默认地址。
# VITE_LOVECOMPASS_API_MIRROR_URL="https://api.mirror.example.com"
# VITE_SUPABASE_MIRROR_URL="https://sb.mirror.example.com"
# VITE_MIRROR_HOSTNAMES="mirror.example.com"
# VITE_AUTO_MIRROR_FOR_CN="true"

# 开发测试工具（可选）。本地 npm run dev 默认开启；生产预览需显式设为 true。
# 上线前删除 frontend/src/lib/dev/ 与 frontend/src/components/dev/ 即可。
# VITE_DEV_RANDOM_FILL="true"
