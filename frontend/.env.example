# LoveCompass 前端环境变量模板
# 说明：浏览器端只能放 Supabase URL 与 anon/publishable key。
# 严禁在本文件或任何前端代码中放入 SUPABASE_SERVICE_ROLE_KEY、sb_secret_*、DATABASE_URL 或 AI Key。

# Supabase 公开配置。当前项目已在 vite.config.ts 中允许 NEXT_PUBLIC_ 前缀被前端读取。
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxx_or_anon_jwt"

# 可选：兼容 Lovable/Vite 原始命名。若已配置 NEXT_PUBLIC_*，通常不必重复配置。
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT_REF"
VITE_SUPABASE_ANON_KEY="sb_publishable_xxx_or_anon_jwt"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx_or_anon_jwt"

# 独立后端 API。开发时通常为 http://localhost:8000；Vercel 临时上线时填后端部署地址。
VITE_LOVECOMPASS_API_BASE_URL="http://localhost:8000"

# AI SDK 服务端适配层变量：仅供 server routes/functions 或 Vercel Environment Variables 使用。
# 不得加 NEXT_PUBLIC_ 或 VITE_ 前缀，不得在浏览器组件中读取。
AI_PROVIDER="zhipu"
ZHIPU_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
ZHIPU_MODEL="glm-4-flash"
# ZHIPU_API_KEY="your_zhipu_key_here"
